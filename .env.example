# Modo de compilación de la aplicación:
# - full: Sistema completo (Login, Registro de Actas, Verificación, Dashboard, TV, Administración)
# - digitador: Modo exclusivo para delegados/digitadores (Login y Registro de Actas con tree-shaking)
VITE_APP_MODE=full

# URL base de la API del backend (sin barra final después de /api):
# - Desarrollo local: http://localhost:8000/api
# - Producción (Cloudflare / GitHub Actions): https://api.tu-dominio.com/api
VITE_API_URL=http://localhost:8000/api
